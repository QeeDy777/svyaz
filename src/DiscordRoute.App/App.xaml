<Application x:Class="DiscordRoute.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ThemeMode="Dark" ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="BrandPaper" Color="#121416"/>
        <SolidColorBrush x:Key="BrandPanel" Color="#1C1F22"/>
        <SolidColorBrush x:Key="BrandPanel2" Color="#25292C"/>
        <SolidColorBrush x:Key="BrandInput" Color="#17191B"/>
        <SolidColorBrush x:Key="BrandLine" Color="#393D40"/>
        <SolidColorBrush x:Key="BrandInk" Color="#F3F3EF"/>
        <SolidColorBrush x:Key="BrandMuted" Color="#AAB0AF"/>
        <SolidColorBrush x:Key="BrandAccent" Color="#FFB770"/>
        <SolidColorBrush x:Key="BrandOnAccent" Color="#261B12"/>
        <SolidColorBrush x:Key="BrandAccentTint" Color="#15FFB770"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#A6DEC0"/>
        <SolidColorBrush x:Key="BrandWarning" Color="#F5C542"/>
        <SolidColorBrush x:Key="BrandError" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="BrandButton" Color="#303437"/>
        <SolidColorBrush x:Key="BrandHover" Color="#FFC88E"/>
        <SolidColorBrush x:Key="BrandHeroLine" Color="#665344"/>
        <RadialGradientBrush x:Key="BrandHero" Center="1,1.2" GradientOrigin="1,1.2" RadiusX="0.85" RadiusY="1.15">
            <GradientStop Color="#9F6540" Offset="0"/>
            <GradientStop Color="#513B2C" Offset="0.36"/>
            <GradientStop Color="#242322" Offset="1"/>
        </RadialGradientBrush>
        <Style x:Key="BrandFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="9" RadiusY="9" Stroke="{DynamicResource BrandAccent}" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrandAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrandHover}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource BrandAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandOnAccent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConnectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="ContentTemplate"><Setter.Value>
                <DataTemplate>
                    <Grid x:Name="ActionContent">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path Data="M 12,2 L 12,10 M 6,5 A 8,8 0 1 0 18,5"
                            Width="16" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                            Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True"/>
                                <Condition Binding="{Binding Path=(SystemParameters.ClientAreaAnimation)}" Value="True"/>
                                <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PressFeedback">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActionContent" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            To="1.5" Duration="0:0:0.07" DecelerationRatio="1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="PressFeedback"/></MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BrandButton}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandInk}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandLine}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrandPanel2}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandMuted}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource BrandInput}"/><Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource BrandMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocus}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Surface" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="SelectedLine" Width="29" Height="2" CornerRadius="1" VerticalAlignment="Top"
                                Background="{DynamicResource BrandAccent}" Visibility="Hidden" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource BrandPanel2}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource BrandAccent}"/><Setter TargetName="SelectedLine" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Bottom"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Stretch"/>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BrandLine}" BorderThickness="0,1,0,0"
                                Background="{DynamicResource BrandPaper}" Padding="2,6">
                            <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrandInk}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource BrandFocus}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="30">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border x:Name="Track" Grid.Column="1" Background="{DynamicResource BrandButton}" BorderBrush="{DynamicResource BrandMuted}"
                                BorderThickness="1" Width="38" Height="22" CornerRadius="11" VerticalAlignment="Center" Padding="3,0">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Fill="{DynamicResource BrandMuted}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource BrandPaper}"/>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandGreen}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandGreen}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandAccent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PageScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb MinHeight="24">
                                <Thumb.Template><ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"><Border x:Name="Handle" Margin="5,0" CornerRadius="3" Background="{DynamicResource BrandMuted}"/></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource BrandAccent}"/></Trigger>
                                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource BrandAccent}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="PageScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <Border Padding="{TemplateBinding Padding}" Margin="0,0,14,0">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        </Border>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource PageScrollBar}" Orientation="Vertical" Margin="0,16,0,12"
                            Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrandPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrandMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Application.Resources>
</Application>
