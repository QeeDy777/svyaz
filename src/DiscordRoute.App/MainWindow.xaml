<Window x:Class="DiscordRoute.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DiscordRoute.App"
    Title="Связь" Width="440" Height="680" ResizeMode="CanMinimize" Icon="Assets/app.ico"
    WindowStartupLocation="CenterScreen" FontFamily="Inter, Segoe UI Variable, Segoe UI"
    FontSize="14" UseLayoutRounding="True" Language="ru-RU"
    Background="{DynamicResource BrandPaper}"
    Foreground="{DynamicResource BrandInk}">
    <Window.Resources>
        <local:EmptyVisibilityConverter x:Key="EmptyVisibility"/>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="31"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <DataTemplate x:Key="NavHeader">
            <StackPanel HorizontalAlignment="Center">
                <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Width="17" Height="17"
                    Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ServiceCheck}">
            <Grid ToolTip="{Binding Detail}" MinHeight="36">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="CheckResult"/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BrandLine}"/>
                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrandMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Passed"><Setter Property="TextElement.Foreground" Value="{DynamicResource BrandGreen}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Checking"><Setter Property="TextElement.Foreground" Value="{DynamicResource BrandAccent}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Unconfirmed"><Setter Property="TextElement.Foreground" Value="{DynamicResource BrandWarning}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Failed"><Setter Property="TextElement.Foreground" Value="{DynamicResource BrandError}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                        Fill="{Binding Foreground, ElementName=CheckText}"/>
                    <TextBlock x:Name="CheckText" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BrandLine}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid MinHeight="38">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource BrandAccent}">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Width="17" Height="18" Stretch="Uniform"
                            Fill="{DynamicResource BrandOnAccent}" Data="M 3,6 l 3,0 -3,12 -3,0 Z M 9,0 l 3,0 -5,18 -3,0 Z M 12,9 l 3,0 -2,8 -3,0 Z"/>
                    </Border>
                    <TextBlock Text="Связь" FontWeight="Bold" FontSize="19" Margin="8,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppUpdates.Version}" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding DiscordSummary}" TextAlignment="Right" Style="{StaticResource SecondaryText}" FontSize="11"/>
                    <TextBlock Text="{Binding Telegram.Summary}" TextAlignment="Right" Style="{StaticResource SecondaryText}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="UpdateNotice" Grid.Row="1" DataContext="{Binding AppUpdates}" Background="{DynamicResource BrandAccentTint}" CornerRadius="14" Padding="14" Margin="16,10,16,0" BorderThickness="1" BorderBrush="{DynamicResource BrandHeroLine}"
            Visibility="{Binding IsNoticeVisible, Converter={StaticResource VisibleIfTrue}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding NoticeTitle}">
            <StackPanel>
                <TextBlock Text="{Binding NoticeTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NoticeDetail}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="Обновить и перезапустить" Command="{Binding RestartCommand}" FontSize="12" Padding="10,8" MinHeight="36"/>
                    <Button Grid.Column="1" Content="Позже" Command="{Binding DismissCommand}" Style="{StaticResource QuietButton}" FontSize="12" Padding="12,8" MinHeight="36" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        <TabControl x:Name="MainTabs" Grid.Row="2" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
            <TabItem Header="Подключение" HeaderTemplate="{StaticResource NavHeader}" Tag="M 2,2 h 6 v 6 h -6 Z M 12,2 h 6 v 6 h -6 Z M 2,12 h 6 v 6 h -6 Z M 12,12 h 6 v 6 h -6 Z" Padding="2,5" AutomationProperties.Name="Подключение выбранных сервисов">
                <ScrollViewer Style="{StaticResource PageScrollViewer}" Foreground="{DynamicResource BrandInk}" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,16,0,18">
                    <StackPanel>
                        <Border Background="{DynamicResource BrandHero}" BorderBrush="{DynamicResource BrandHeroLine}"
                            BorderThickness="1" CornerRadius="16" Margin="0,0,0,16">
                            <Grid>
                                <Path IsHitTestVisible="False" Width="104" Height="55" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,10,12,0" Stroke="{DynamicResource BrandAccent}" StrokeThickness="1" Opacity="0.13"
                                    Data="M 20,108 Q 34,57 137,28 M 37,108 Q 50,68 137,43 M 55,108 Q 65,80 137,58 M 77,108 Q 88,88 137,74 M 101,108 Q 114,98 137,90"/>
                                <StackPanel Margin="16">
                                    <TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding CurrentStrategy, StringFormat='Текущий альт · {0}'}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0"
                                        Visibility="{Binding IsProcessRunning, Converter={StaticResource VisibleIfTrue}}"/>
                                    <Button x:Name="ConnectionAction" Content="{Binding PrimaryActionLabel}" Style="{StaticResource ConnectionButton}" Margin="0,14,0,0"
                                        Command="{Binding PrimaryCommand}" AutomationProperties.Name="{Binding PrimaryActionLabel}" ToolTip="{Binding PrimaryActionLabel}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ProgressBar x:Name="ConnectionProgress" Height="3" Margin="0,0,0,8" Value="100"
                            IsIndeterminate="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                            Visibility="{Binding ShowProgress, Converter={StaticResource VisibleIfTrue}}" AutomationProperties.Name="Выполняется операция"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Проверки" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedServicesSummary}" ToolTip="Выбранные сервисы"
                                Style="{StaticResource SecondaryText}" FontSize="12" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.IsSharedSizeScope="True" Margin="0,0,0,10">
                            <ContentControl Content="{Binding Api}" Visibility="{Binding Services.Discord, Converter={StaticResource VisibleIfTrue}}"/>
                            <ContentControl Content="{Binding Gateway}" Visibility="{Binding Services.Discord, Converter={StaticResource VisibleIfTrue}}"/>
                            <ContentControl Content="{Binding Voice}" Visibility="{Binding Services.Discord, Converter={StaticResource VisibleIfTrue}}"/>
                            <ContentControl x:Name="YouTubeCheck" Content="{Binding YouTube}" Visibility="{Binding Services.YouTube, Converter={StaticResource VisibleIfTrue}}"/>
                            <ContentControl Content="{Binding Telegram.ServerCheck}" Visibility="{Binding Services.Telegram, Converter={StaticResource VisibleIfTrue}}"/>
                        </StackPanel>
                        <Border x:Name="QualityPanel" Background="{DynamicResource BrandPanel2}" CornerRadius="12" Padding="10" Margin="0,0,0,12" Visibility="{Binding HasQuality, Converter={StaticResource VisibleIfTrue}}">
                            <StackPanel>
                                <TextBlock Text="{Binding QualitySummary}" TextWrapping="Wrap" FontSize="12"/>
                                <TextBlock Text="Время ответа сервисов за последние пять проверок." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Visibility="{Binding Services.YouTube, Converter={StaticResource VisibleIfTrue}}" Text="Для YouTube проверяется ответ сайта и Googlevideo." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,12"/>
                        <StackPanel Visibility="{Binding Services.UsesZapret, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,0,14">
                            <Button x:Name="FullScanButton" Content="Полный подбор" Command="{Binding FullScanCommand}" Style="{StaticResource QuietButton}"/>
                            <TextBlock Text="Проверяет все альты для этой сети. Во время подбора связь может прерываться." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Content="{Binding HelpActionLabel}" Command="{Binding HelpCommand}" Visibility="{Binding ShowRepair, Converter={StaticResource VisibleIfTrue}}" Style="{StaticResource QuietButton}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding ConnectionTime}" Visibility="{Binding IsProcessRunning, Converter={StaticResource VisibleIfTrue}}" Style="{StaticResource SecondaryText}" FontSize="12" TextAlignment="Center"/>
                        <TextBlock Text="{Binding LastCheck}" Visibility="{Binding HasLastCheck, Converter={StaticResource VisibleIfTrue}}" Style="{StaticResource SecondaryText}" FontSize="12" TextAlignment="Center" Margin="0,4,0,12"/>
                        <Border Style="{StaticResource Card}" Padding="12,6">
                            <Expander Header="История проверок" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="После подключения здесь появятся результаты подбора." Style="{StaticResource SecondaryText}" Margin="0,0,0,12"
                                        Visibility="{Binding Results.Count, Converter={StaticResource EmptyVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding Results}" AutomationProperties.Name="Результаты проверки стратегий">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BrandLine}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                        <TextBlock Text="{Binding Quality}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                                                        <TextBlock Text="{Binding Api, StringFormat=API: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Gateway, StringFormat=Gateway: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Voice, StringFormat=Голос: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                        <TextBlock Text="{Binding YouTube, StringFormat=YouTube: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Telegram" HeaderTemplate="{StaticResource NavHeader}" Tag="M 2,9 L 19,2 15,18 9,13 6,16 6.5,11 Z M 6.5,11 L 15,6 9,13" Padding="2,5" AutomationProperties.Name="Telegram">
                <ScrollViewer Style="{StaticResource PageScrollViewer}" Foreground="{DynamicResource BrandInk}" FontSize="14" VerticalScrollBarVisibility="Auto" Padding="16,16,0,18">
                    <StackPanel DataContext="{Binding Telegram}">
                        <TextBlock Text="Telegram" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Прокси Flowseal" FontWeight="SemiBold" FontSize="18"/>
                                <TextBlock Text="{Binding Endpoint}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource BrandAccent}" FontSize="13" Margin="0,4,0,10"/>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
                                <Button Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource QuietButton}" Content="{Binding HelpActionLabel}" Command="{Binding HelpCommand}"
                                    Visibility="{Binding HasFailure, Converter={StaticResource VisibleIfTrue}}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <ContentControl Content="{Binding ServerCheck}"/>
                                <TextBlock Text="{Binding QualitySummary}" Visibility="{Binding HasQuality, Converter={StaticResource VisibleIfTrue}}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0" ToolTip="Отклик последних пяти проверок MTProto через прокси"/>
                                <TextBlock Text="{Binding ConnectionTime}" Style="{StaticResource SecondaryText}" Margin="0,4,0,10"/>
                                <Button Style="{StaticResource QuietButton}" Content="Проверить сервер" Command="{Binding CheckCommand}"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Style="{StaticResource QuietButton}" Content="Открыть в Telegram" Command="{Binding OpenCommand}" Padding="6,9" FontSize="13" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource QuietButton}" Content="Скопировать ссылку" Command="{Binding CopyCommand}" Padding="6,9" FontSize="13" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <TextBlock Text="Откройте ссылку и подтвердите подключение в Telegram." Style="{StaticResource SecondaryText}" Margin="0,0,0,14"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Expander x:Name="TelegramOptions" Header="Настройки Telegram" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,16,0,0">
                                    <StackPanel IsEnabled="{Binding CanEdit}">
                                        <Label Content="Локальный порт" Target="{Binding ElementName=TelegramPort}" Padding="0" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TelegramPort" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" MinHeight="38" AutomationProperties.Name="Локальный порт Telegram"/>
                                        <CheckBox Content="Запускать вместе со «Связью»" IsChecked="{Binding StartWithApp}" Margin="0,16,0,16"/>
                                        <Button Style="{StaticResource QuietButton}" Content="Сохранить настройки" Command="{Binding SaveCommand}" Padding="18,10" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Перед изменением настроек остановите прокси. Движок обновляется вместе со «Связью»." Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Expander>
                        </Border>
                        <TextBlock Text="После остановки выключите прокси в Telegram или запустите его снова." Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Настройки" HeaderTemplate="{StaticResource NavHeader}" Tag="M 2,5 H 5 M 9,5 H 18 M 2,14 H 12 M 16,14 H 18 M 5,2 h 4 v 6 h -4 Z M 12,11 h 4 v 6 h -4 Z" Padding="2,5" AutomationProperties.Name="Настройки">
                <ScrollViewer Style="{StaticResource PageScrollViewer}" Foreground="{DynamicResource BrandInk}" FontSize="14" VerticalScrollBarVisibility="Auto" Padding="16,16,0,18">
                    <StackPanel>
                        <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Что подключать" Style="{StaticResource SectionTitle}"/>
                                <StackPanel IsEnabled="{Binding CanConfigureServices}">
                                    <CheckBox Content="Discord" IsChecked="{Binding UseDiscord}" Margin="0,0,0,8"/>
                                    <CheckBox Content="YouTube" IsChecked="{Binding UseYouTube}" Margin="0,0,0,8"/>
                                    <CheckBox Content="Telegram" IsChecked="{Binding UseTelegram}" Margin="0,0,0,12"/>
                                    <CheckBox Content="Сообщать о длительном сбое" IsChecked="{Binding QuietNotifications}" Margin="0,0,0,12"/>
                                    <Button Content="Сохранить выбор" Command="{Binding ServicesCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectionFeedback}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="Проверяем сервисы при подключении. Работающий альт не переключается автоматически, в том числе после сна и смены сети." Style="{StaticResource SecondaryText}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding AppUpdates}">
                            <StackPanel>
                                <Expander x:Name="ReleaseHistory" Header="Что нового · история версий" IsExpanded="{Binding ShowWhatsNew}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock x:Name="CurrentNotesBlock" Text="{Binding CurrentNotes}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                                        <TextBlock Text="{Binding EarlierNotes}" Style="{StaticResource SecondaryText}"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="{Binding InstalledHistory}" Style="{StaticResource SecondaryText}" Margin="0,16,0,12"/>
                                <Button Content="{Binding RollbackLabel}" Command="{Binding RollbackCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                                <TextBlock Text="Откат перезапустит приложение и выключит автообновление. Настройки сохранятся. Включить обновления снова можно ниже." Style="{StaticResource SecondaryText}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Диагностика" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding DiagnosticFeedback}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
                                <Button Content="Сохранить отчёт" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Работает автоматически" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Подключать при входе в Windows" IsChecked="{Binding AutostartEnabled, Mode=OneWay}" Command="{Binding AutostartCommand}" Margin="0,0,0,8"/>
                                <TextBlock Text="Подключение начнётся через 15 секунд после входа. Приложение останется в трее." Style="{StaticResource SecondaryText}" Margin="28,0,0,22"/>
                                <CheckBox Content="Обновлять «Связь» и компоненты" IsChecked="{Binding AutoUpdateEnabled}" Command="{Binding AutoUpdateCommand}" Margin="0,0,0,8"/>
                                <TextBlock Text="Проверка каждые 6 часов. «Связь» скачивается в фоне и обновляется при следующем запуске вместе с Telegram-прокси." Style="{StaticResource SecondaryText}" Margin="28,0,0,16"/>
                                <TextBlock Text="{Binding PackageVersion}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource QuietButton}" Content="Обновить альты" Command="{Binding UpdateCommand}" HorizontalAlignment="Left" Padding="18,10"/>
                                <Button x:Name="ResetZapretButton" Style="{StaticResource QuietButton}" Content="Сбросить кэш zapret" Command="{Binding ResetZapretCommand}" HorizontalAlignment="Left" Padding="18,10" Margin="0,10,0,0"/>
                                <TextBlock Text="Выгружает WinDivert, удаляет его службу, пакеты и списки zapret. Затем загружает свежую копию и запускает подбор." Style="{StaticResource SecondaryText}" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding ResetFeedback}" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding AppUpdates}">
                            <StackPanel>
                                <TextBlock Text="Обновление «Связи»" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource QuietButton}" Content="Проверить новую версию" Command="{Binding CheckCommand}" HorizontalAlignment="Left" Padding="18,10" Margin="0,0,0,8"/>
                                <Button Content="Обновить и перезапустить" Command="{Binding RestartCommand}" HorizontalAlignment="Left" Padding="18,10"/>
                                <TextBlock Text="Перезапуск кратко прервёт подключения. Предыдущая версия и настройки сохраняются." Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <TextBlock Text="Игры · Game Filter" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Режим" Target="{Binding ElementName=GameFilterPicker}" Padding="0" Margin="0,0,0,8"/>
                                <ComboBox x:Name="GameFilterPicker" ItemsSource="{Binding GameFilterModes}" SelectedIndex="{Binding GameFilterModeIndex}" MinHeight="38" AutomationProperties.Name="Режим Game Filter"/>
                                <TextBlock Text="{Binding GameFilterSummary}" Style="{StaticResource SecondaryText}" Margin="0,8,0,12"/>
                                <Expander Header="Диапазоны портов" HorizontalContentAlignment="Stretch" Margin="0,0,0,16">
                                    <StackPanel Margin="0,12,0,0">
                                        <Label Content="TCP" Target="{Binding ElementName=GameTcpInput}" Padding="0" Margin="0,0,0,6"/>
                                        <TextBox x:Name="GameTcpInput" Text="{Binding GameFilterTcpPorts, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" MinHeight="38" AutomationProperties.Name="TCP порты Game Filter"/>
                                        <Label Content="UDP" Target="{Binding ElementName=GameUdpInput}" Padding="0" Margin="0,12,0,6"/>
                                        <TextBox x:Name="GameUdpInput" Text="{Binding GameFilterUdpPorts, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" MinHeight="38" AutomationProperties.Name="UDP порты Game Filter"/>
                                        <TextBlock Text="По умолчанию: 1024–65535. Можно указать несколько портов и диапазонов через запятую." Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Expander>
                                <Button Style="{StaticResource QuietButton}" Content="Сохранить Game Filter" Command="{Binding GameFilterCommand}" HorizontalAlignment="Left" Padding="18,10"/>
                                <TextBlock Text="{Binding GameFilterFeedback}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="{Binding GameFilterHint}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                                <TextBlock Text="Обрабатывает выбранные порты для сетей из IPSet Flowseal. Работу конкретной игры нужно проверить в игре." Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <TextBlock Text="Параметры подключения" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Стратегия" Target="{Binding ElementName=StrategyPicker}" Padding="0" Margin="0,0,0,8"/>
                                <ComboBox x:Name="StrategyPicker" ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" MinHeight="38" AutomationProperties.Name="Стратегия обхода"/>
                                <TextBlock Text="При автоподборе сначала проверим альт, сохранённый для текущей сети." Style="{StaticResource SecondaryText}" Margin="0,8,0,22"/>
                                <TextBlock Text="{Binding NetworkSummary}" Style="{StaticResource SecondaryText}" Margin="0,0,0,18"/>
                                <Label Content="Голосовой сервер · необязательно" Target="{Binding ElementName=VoiceInput}" Padding="0" Margin="0,0,0,8"/>
                                <TextBox x:Name="VoiceInput" Text="{Binding VoiceAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" AutomationProperties.Name="Адрес голосового сервера"/>
                                <TextBlock Text="Оставьте пустым для определения из журнала Discord. Если адрес ещё не появился, откройте голосовой канал. Формат: имя.discord.media:порт." Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Журнал" HeaderTemplate="{StaticResource NavHeader}" Tag="M 3,2 h 14 v 16 h -14 Z M 6.5,7 h 7 M 6.5,11 h 7" Padding="2,5" AutomationProperties.Name="Журнал">
                <Grid Margin="16,16,16,14" TextElement.Foreground="{DynamicResource BrandInk}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Журнал" Style="{StaticResource PageTitle}"/>
                    <TextBlock Grid.Row="1" Text="Проверки, обновления и сообщения zapret. Выделите текст, чтобы скопировать." Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/>
                    <Border Grid.Row="2" Background="{DynamicResource BrandInput}" BorderBrush="{DynamicResource BrandLine}" BorderThickness="1" CornerRadius="16" Padding="2">
                        <Grid>
                            <TextBox x:Name="JournalEntries" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandInk}" Text="{Binding Journal, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" AutomationProperties.Name="Журнал работы">
                                <TextBox.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource PageScrollViewer}"/></TextBox.Resources>
                            </TextBox>
                            <TextBlock x:Name="EmptyJournalHint" Text="Записей пока нет" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=JournalEntries}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
