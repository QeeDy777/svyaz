<Window x:Class="DiscordRoute.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DiscordRoute.App"
    Title="Связь" Width="440" Height="680" ResizeMode="CanMinimize" Icon="Assets/app.ico"
    WindowStartupLocation="CenterScreen" FontFamily="Inter, Segoe UI Variable, Segoe UI"
    FontSize="14" UseLayoutRounding="True" Language="ru-RU"
    Background="{DynamicResource BrandPaper}"
    Foreground="{DynamicResource BrandInk}">
    <Window.Resources>
        <local:EmptyVisibilityConverter x:Key="EmptyVisibility"/>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="31"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <DataTemplate x:Key="NavHeader">
            <StackPanel HorizontalAlignment="Center">
                <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Width="17" Height="17"
                    Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ServiceCheck}">
            <Grid ToolTip="{Binding Detail}" MinHeight="36">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="CheckResult"/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BrandLine}"/>
                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrandMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Passed"><Setter Property="TextElement.Foreground" Value="{DynamicResource BrandGreen}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Checking"><Setter Property="TextElement.Foreground" Value="{DynamicResource BrandAccent}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Unconfirmed"><Setter Property="TextElement.Foreground" Value="{DynamicResource BrandWarning}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Failed"><Setter Property="TextElement.Foreground" Value="{DynamicResource BrandError}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                        Fill="{Binding Foreground, ElementName=CheckText}"/>
                    <TextBlock x:Name="CheckText" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BrandLine}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid MinHeight="34">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="30" Height="30" Source="Assets/icon-source.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Связь" FontWeight="Bold" FontSize="19" Margin="8,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppUpdates.Version}" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl x:Name="HeaderServicesList" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                    ItemsSource="{Binding HeaderServices}" AutomationProperties.Name="Состояние сервисов">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="9,0,0,0" ToolTip="{Binding Summary}">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center"
                                Stroke="{DynamicResource BrandMuted}" Fill="Transparent"/>
                            <TextBlock x:Name="Caption" Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BrandMuted}"
                                AutomationProperties.Name="{Binding Summary}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Checking"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource BrandAccent}"/><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource BrandAccent}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Unconfirmed"><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource BrandWarning}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Passed"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource BrandGreen}"/><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource BrandGreen}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Failed"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource BrandError}"/><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource BrandError}"/><Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource BrandError}"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <Border x:Name="UpdateNotice" Grid.Row="1" DataContext="{Binding AppUpdates}" Background="{DynamicResource BrandAccentTint}" CornerRadius="14" Padding="14" Margin="16,10,16,0" BorderThickness="1" BorderBrush="{DynamicResource BrandHeroLine}"
            Visibility="{Binding IsNoticeVisible, Converter={StaticResource VisibleIfTrue}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding NoticeTitle}">
            <StackPanel>
                <TextBlock Text="{Binding NoticeTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NoticeDetail}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="Обновить и перезапустить" Command="{Binding RestartCommand}" FontSize="12" Padding="10,8" MinHeight="36"/>
                    <Button Grid.Column="1" Content="Позже" Command="{Binding DismissCommand}" Style="{StaticResource QuietButton}" FontSize="12" Padding="12,8" MinHeight="36" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        <TabControl x:Name="MainTabs" Grid.Row="2" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
            <TabItem Header="Подключение" HeaderTemplate="{StaticResource NavHeader}" Tag="M 2,2 h 6 v 6 h -6 Z M 12,2 h 6 v 6 h -6 Z M 2,12 h 6 v 6 h -6 Z M 12,12 h 6 v 6 h -6 Z" Padding="2,5" AutomationProperties.Name="Подключение выбранных сервисов">
                <ScrollViewer Style="{StaticResource PageScrollViewer}" Foreground="{DynamicResource BrandInk}" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,16,0,18">
                    <StackPanel>
                        <Border Background="{DynamicResource BrandHero}" BorderBrush="{DynamicResource BrandHeroLine}"
                            BorderThickness="1" CornerRadius="16" Margin="0,0,0,16">
                            <Grid>
                                <Path IsHitTestVisible="False" Width="104" Height="55" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,10,12,0" Stroke="{DynamicResource BrandAccent}" StrokeThickness="1" Opacity="0.13"
                                    Data="M 20,108 Q 34,57 137,28 M 37,108 Q 50,68 137,43 M 55,108 Q 65,80 137,58 M 77,108 Q 88,88 137,74 M 101,108 Q 114,98 137,90"/>
                                <StackPanel Margin="16">
                                    <TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding CurrentStrategy, StringFormat='Текущий альт · {0}'}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0"
                                        Visibility="{Binding IsProcessRunning, Converter={StaticResource VisibleIfTrue}}"/>
                                    <Button x:Name="ConnectionAction" Content="{Binding PrimaryActionLabel}" Style="{StaticResource ConnectionButton}" Margin="0,14,0,0"
                                        Command="{Binding PrimaryCommand}" AutomationProperties.Name="{Binding PrimaryActionLabel}" ToolTip="{Binding PrimaryActionLabel}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ProgressBar x:Name="ConnectionProgress" Height="3" Margin="0,0,0,8" Value="100"
                            IsIndeterminate="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                            Visibility="{Binding ShowProgress, Converter={StaticResource VisibleIfTrue}}" AutomationProperties.Name="Выполняется операция"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Проверки" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedServicesSummary}" ToolTip="Выбранные сервисы"
                                Style="{StaticResource SecondaryText}" FontSize="12" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.IsSharedSizeScope="True" Margin="0,0,0,10">
                            <ContentControl Content="{Binding Api}" Visibility="{Binding Services.Discord, Converter={StaticResource VisibleIfTrue}}"/>
                            <ContentControl Content="{Binding Gateway}" Visibility="{Binding Services.Discord, Converter={StaticResource VisibleIfTrue}}"/>
                            <ContentControl Content="{Binding Voice}" Visibility="{Binding Services.Discord, Converter={StaticResource VisibleIfTrue}}"/>
                            <ContentControl x:Name="YouTubeCheck" Content="{Binding YouTube}" Visibility="{Binding Services.YouTube, Converter={StaticResource VisibleIfTrue}}"/>
                            <ContentControl Content="{Binding Telegram.ServerCheck}" Visibility="{Binding Services.Telegram, Converter={StaticResource VisibleIfTrue}}"/>
                        </StackPanel>
                        <Border x:Name="QualityPanel" Background="{DynamicResource BrandPanel2}" CornerRadius="12" Padding="10" Margin="0,0,0,12" Visibility="{Binding HasQuality, Converter={StaticResource VisibleIfTrue}}">
                            <StackPanel>
                                <TextBlock Text="{Binding QualitySummary}" TextWrapping="Wrap" FontSize="12"/>
                                <TextBlock Text="Время ответа сервисов за последние пять проверок." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Visibility="{Binding Services.YouTube, Converter={StaticResource VisibleIfTrue}}" Text="Для YouTube проверяется ответ сайта и Googlevideo." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,12"/>
                        <StackPanel Visibility="{Binding Services.UsesZapret, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,0,14">
                            <Button x:Name="FullScanButton" Content="Полный подбор" Command="{Binding FullScanCommand}" Style="{StaticResource QuietButton}"/>
                            <TextBlock Text="Проверяет все альты для этой сети. Во время подбора связь может прерываться." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Content="{Binding HelpActionLabel}" Command="{Binding HelpCommand}" Visibility="{Binding ShowRepair, Converter={StaticResource VisibleIfTrue}}" Style="{StaticResource QuietButton}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding ConnectionTime}" Visibility="{Binding IsProcessRunning, Converter={StaticResource VisibleIfTrue}}" Style="{StaticResource SecondaryText}" FontSize="12" TextAlignment="Center"/>
                        <TextBlock Text="{Binding LastCheck}" Visibility="{Binding HasLastCheck, Converter={StaticResource VisibleIfTrue}}" Style="{StaticResource SecondaryText}" FontSize="12" TextAlignment="Center" Margin="0,4,0,12"/>
                        <Border Style="{StaticResource Card}" Padding="12,6">
                            <Expander Header="История проверок" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="После подключения здесь появятся результаты подбора." Style="{StaticResource SecondaryText}" Margin="0,0,0,12"
                                        Visibility="{Binding Results.Count, Converter={StaticResource EmptyVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding Results}" AutomationProperties.Name="Результаты проверки стратегий">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BrandLine}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                        <TextBlock Text="{Binding Quality}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                                                        <TextBlock Text="{Binding Api, StringFormat=API: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Gateway, StringFormat=Gateway: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Voice, StringFormat=Голос: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                        <TextBlock Text="{Binding YouTube, StringFormat=YouTube: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Telegram" HeaderTemplate="{StaticResource NavHeader}" Tag="M 2,9 L 19,2 15,18 9,13 6,16 6.5,11 Z M 6.5,11 L 15,6 9,13" Padding="2,5" AutomationProperties.Name="Telegram">
                <ScrollViewer Style="{StaticResource PageScrollViewer}" Foreground="{DynamicResource BrandInk}" FontSize="14" VerticalScrollBarVisibility="Auto" Padding="16,16,0,18">
                    <StackPanel DataContext="{Binding Telegram}">
                        <Border Background="{DynamicResource BrandHero}" BorderBrush="{DynamicResource BrandHeroLine}"
                            BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Прокси Telegram" FontWeight="SemiBold" FontSize="28" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="TelegramAction" Content="{Binding PrimaryLabel}"
                                    Command="{Binding PrimaryCommand}" AutomationProperties.Name="{Binding PrimaryLabel}" Margin="0,14,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ConnectionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrandButton}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandLine}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource BrandInk}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRunning}" Value="True"/>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource BrandPanel2}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Content="{Binding HelpActionLabel}" Command="{Binding HelpCommand}"
                                    Visibility="{Binding HasFailure, Converter={StaticResource VisibleIfTrue}}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="TelegramClientActions" Visibility="{Binding IsRunning, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,0,16">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Адрес прокси" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Endpoint}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                    VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Margin="10,0,0,0"/>
                            </Grid>
                            <UniformGrid Columns="2">
                                <Button x:Name="TelegramOpenButton" Content="Открыть в Telegram" Command="{Binding OpenCommand}" Padding="6,9" FontSize="13" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource QuietButton}" Content="Скопировать ссылку" Command="{Binding CopyCommand}" Padding="6,9" FontSize="13" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Проверка" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionTime}" Style="{StaticResource SecondaryText}"
                                Visibility="{Binding IsRunning, Converter={StaticResource VisibleIfTrue}}" VerticalAlignment="Center" TextAlignment="Right" FontSize="12" Margin="10,0,0,0"/>
                        </Grid>
                        <ContentControl Content="{Binding ServerCheck}"/>
                        <TextBlock Text="{Binding QualitySummary}" Visibility="{Binding HasQuality, Converter={StaticResource VisibleIfTrue}}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0" ToolTip="Отклик последних пяти проверок MTProto через прокси"/>
                        <Button x:Name="TelegramCheckButton" Visibility="{Binding IsRunning, Converter={StaticResource VisibleIfTrue}}"
                            Style="{StaticResource QuietButton}" Content="Проверить сервер" Command="{Binding CheckCommand}" Margin="0,8,0,0"/>
                        <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,16,0,8">
                            <Expander x:Name="TelegramOptions" Header="Настройки Telegram" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,16,0,0">
                                    <StackPanel IsEnabled="{Binding CanEdit}">
                                        <Label Content="Локальный порт" Target="{Binding ElementName=TelegramPort}" Padding="0" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TelegramPort" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" MinHeight="38" AutomationProperties.Name="Локальный порт Telegram"/>
                                        <CheckBox Content="Запускать вместе со «Связью»" IsChecked="{Binding StartWithApp}" Margin="0,16,0,16"/>
                                        <Button Style="{StaticResource QuietButton}" Content="Сохранить настройки" Command="{Binding SaveCommand}" Padding="18,10" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="Перед изменением настроек остановите прокси. Движок обновляется вместе со «Связью»." Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,8"/>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Настройки" HeaderTemplate="{StaticResource NavHeader}" Tag="M 2,5 H 5 M 9,5 H 18 M 2,14 H 12 M 16,14 H 18 M 5,2 h 4 v 6 h -4 Z M 12,11 h 4 v 6 h -4 Z" Padding="2,5" AutomationProperties.Name="Настройки">
                <ScrollViewer Style="{StaticResource PageScrollViewer}" Foreground="{DynamicResource BrandInk}" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,16,0,18">
                    <ScrollViewer.Resources>
                        <Style x:Key="SettingsHint" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                        <Style x:Key="SettingsFeedback" TargetType="TextBlock" BasedOn="{StaticResource SettingsHint}">
                            <Setter Property="Margin" Value="0,8,0,0"/>
                            <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="SettingsSection" TargetType="Expander">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="Expander">
                                    <Border BorderBrush="{DynamicResource BrandLine}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" Cursor="Hand" HorizontalAlignment="Stretch"
                                                FontWeight="SemiBold" FocusVisualStyle="{StaticResource BrandFocus}"
                                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                                    <Grid x:Name="HeaderArea" Background="Transparent" MinHeight="38" Margin="2,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{DynamicResource BrandInk}" RecognizesAccessKey="True"/>
                                                        <Path x:Name="Chevron" Grid.Column="1" Data="M 1,1 L 5,5 1,9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Stroke="{DynamicResource BrandMuted}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderArea" Property="Background" Value="{DynamicResource BrandPanel}"/></Trigger>
                                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 1,1 L 5,5 9,1"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate></ToggleButton.Template>
                                            </ToggleButton>
                                            <ContentPresenter x:Name="Body" Visibility="Collapsed" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="2,4,2,14"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value></Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}" Background="{DynamicResource BrandHero}" BorderBrush="{DynamicResource BrandHeroLine}" Padding="16,12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Сервисы подключения" Style="{StaticResource SectionTitle}" FontSize="21" Margin="0,0,0,4"/>
                                <TextBlock Text="Что запускать кнопкой «Подключить»" Style="{StaticResource SettingsHint}" Margin="0,0,0,4"/>
                                <StackPanel IsEnabled="{Binding CanConfigureServices}">
                                    <CheckBox Content="Discord" IsChecked="{Binding UseDiscord}" MinHeight="30"/>
                                    <Border Height="1" Background="{DynamicResource BrandLine}"/>
                                    <CheckBox Content="YouTube" IsChecked="{Binding UseYouTube}" MinHeight="30"/>
                                    <Border Height="1" Background="{DynamicResource BrandLine}"/>
                                    <CheckBox Content="Telegram" IsChecked="{Binding UseTelegram}" MinHeight="30"/>
                                    <Border Height="1" Background="{DynamicResource BrandLine}"/>
                                    <CheckBox Content="Сообщать о длительном сбое" IsChecked="{Binding QuietNotifications}" MinHeight="30"/>
                                    <Button Content="Сохранить выбор" Command="{Binding ServicesCommand}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Отключите связь, чтобы изменить выбор.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHint}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Margin" Value="0,8,0,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanConfigureServices}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectionFeedback}" Style="{StaticResource SettingsFeedback}"/>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="StartupSettings" Header="Запуск и обновления" Style="{StaticResource SettingsSection}">
                            <StackPanel>
                                <CheckBox Content="Подключать при входе в Windows" IsChecked="{Binding AutostartEnabled, Mode=OneWay}" Command="{Binding AutostartCommand}"/>
                                <TextBlock Text="Через 15 секунд после входа «Связь» запустится в трее." Style="{StaticResource SettingsHint}" Margin="0,4,0,12"/>
                                <CheckBox Content="Обновлять «Связь» и компоненты" IsChecked="{Binding AutoUpdateEnabled}" Command="{Binding AutoUpdateCommand}"/>
                                <TextBlock Text="Проверка каждые 6 часов. Загруженная версия установится при следующем запуске." Style="{StaticResource SettingsHint}" Margin="0,4,0,14"/>
                                <StackPanel DataContext="{Binding AppUpdates}">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource SettingsHint}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
                                    <Button Style="{StaticResource QuietButton}" Content="Проверить новую версию" Command="{Binding CheckCommand}"/>
                                    <Button Content="Обновить и перезапустить" Command="{Binding RestartCommand}" Margin="0,8,0,0"/>
                                    <TextBlock Text="Перезапуск ненадолго прервёт подключение. Предыдущая версия и настройки сохранятся." Style="{StaticResource SettingsHint}" Margin="0,8,0,14"/>
                                    <Expander x:Name="ReleaseHistory" Header="Что нового" IsExpanded="{Binding ShowWhatsNew}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock x:Name="CurrentNotesBlock" Text="{Binding CurrentNotes}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                            <Expander Header="Предыдущие выпуски" HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{Binding EarlierNotes}" Style="{StaticResource SettingsHint}" Margin="0,12,0,0"/>
                                            </Expander>
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="Откат версии" HorizontalContentAlignment="Stretch" Margin="0,6,0,0">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="{Binding InstalledHistory}" Style="{StaticResource SettingsHint}" Margin="0,0,0,8"/>
                                            <TextBlock Text="Откат перезапустит приложение и выключит автообновление. Настройки сохранятся." Style="{StaticResource SettingsHint}" Margin="0,0,0,10"/>
                                            <Button Content="{Binding RollbackLabel}" Command="{Binding RollbackCommand}" Style="{StaticResource QuietButton}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ConnectionSettings" Header="Параметры подключения" Style="{StaticResource SettingsSection}">
                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <Label Content="Стратегия" Target="{Binding ElementName=StrategyPicker}" Padding="0" Margin="0,0,0,6"/>
                                <ComboBox x:Name="StrategyPicker" ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" MinHeight="38" AutomationProperties.Name="Стратегия обхода"/>
                                <TextBlock Text="Проверка проходит при подключении. После сна и смены сети рабочий альт сохраняется." Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
                                <TextBlock Text="При автоподборе сначала проверяется сохранённый для этой сети альт." Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding NetworkSummary}" Style="{StaticResource SettingsHint}" Margin="0,6,0,14"/>
                                <Label Content="Голосовой сервер Discord · необязательно" Target="{Binding ElementName=VoiceInput}" Padding="0" Margin="0,0,0,6"/>
                                <TextBox x:Name="VoiceInput" Text="{Binding VoiceAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" AutomationProperties.Name="Адрес голосового сервера"/>
                                <TextBlock Text="Оставьте поле пустым для поиска в журнале Discord. Если адрес ещё не появился, войдите в голосовой канал. Формат адреса — имя.discord.media:порт." Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="GameSettings" Header="Игры" Style="{StaticResource SettingsSection}">
                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <Label Content="Режим" Target="{Binding ElementName=GameFilterPicker}" Padding="0" Margin="0,0,0,6"/>
                                <ComboBox x:Name="GameFilterPicker" ItemsSource="{Binding GameFilterModes}" SelectedIndex="{Binding GameFilterModeIndex}" MinHeight="38" AutomationProperties.Name="Режим Game Filter"/>
                                <TextBlock Text="{Binding GameFilterSummary}" Style="{StaticResource SettingsHint}" Margin="0,6,0,12"/>
                                <Expander Header="Диапазоны портов" HorizontalContentAlignment="Stretch">
                                    <StackPanel Margin="0,12,0,0">
                                        <Label Content="TCP" Target="{Binding ElementName=GameTcpInput}" Padding="0" Margin="0,0,0,6"/>
                                        <TextBox x:Name="GameTcpInput" Text="{Binding GameFilterTcpPorts, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" MinHeight="38" AutomationProperties.Name="TCP порты Game Filter"/>
                                        <Label Content="UDP" Target="{Binding ElementName=GameUdpInput}" Padding="0" Margin="0,12,0,6"/>
                                        <TextBox x:Name="GameUdpInput" Text="{Binding GameFilterUdpPorts, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" MinHeight="38" AutomationProperties.Name="UDP порты Game Filter"/>
                                        <TextBlock Text="По умолчанию 1024–65535. Перечислите порты и диапазоны через запятую." Style="{StaticResource SettingsHint}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="Фильтр обрабатывает выбранные порты для сетей из IPSet Flowseal. Проверьте подключение в самой игре." Style="{StaticResource SettingsHint}" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding GameFilterHint}" Style="{StaticResource SettingsHint}" Margin="0,6,0,10"/>
                                <Button Style="{StaticResource QuietButton}" Content="Сохранить Game Filter" Command="{Binding GameFilterCommand}"/>
                                <TextBlock Text="{Binding GameFilterFeedback}" Style="{StaticResource SettingsFeedback}"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="DiagnosticSettings" Header="Диагностика" Style="{StaticResource SettingsSection}">
                            <StackPanel>
                                <TextBlock Text="{Binding DiagnosticFeedback}" Style="{StaticResource SettingsHint}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
                                <Button Content="Сохранить отчёт" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="MaintenanceSettings" Header="Обслуживание zapret" Style="{StaticResource SettingsSection}">
                            <StackPanel>
                                <TextBlock Text="{Binding PackageVersion}" Style="{StaticResource SettingsHint}" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource QuietButton}" Content="Обновить альты" Command="{Binding UpdateCommand}"/>
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Полный сброс zapret" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Сброс выгрузит WinDivert и удалит его службу, пакеты и списки zapret. Затем «Связь» скачает свежую копию и начнёт подбор." Style="{StaticResource SettingsHint}" Margin="0,0,0,10"/>
                                        <Button x:Name="ResetZapretButton" Style="{StaticResource QuietButton}" Foreground="{DynamicResource BrandError}" Content="Сбросить кэш zapret" Command="{Binding ResetZapretCommand}"/>
                                        <TextBlock Text="{Binding ResetFeedback}" Style="{StaticResource SettingsFeedback}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Журнал" HeaderTemplate="{StaticResource NavHeader}" Tag="M 3,2 h 14 v 16 h -14 Z M 6.5,7 h 7 M 6.5,11 h 7" Padding="2,5" AutomationProperties.Name="Журнал">
                <Grid Margin="16,16,16,14" TextElement.Foreground="{DynamicResource BrandInk}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Журнал" Style="{StaticResource PageTitle}"/>
                    <Grid x:Name="JournalBody" Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid"><Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=JournalEntries}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style>
                        </Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Выделите записи и нажмите Ctrl+C, чтобы скопировать." Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,0,0,12"/>
                        <TextBox x:Name="JournalEntries" Grid.Row="1" Foreground="{DynamicResource BrandInk}" Text="{Binding Journal, Mode=OneWay}"
                            IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" FocusVisualStyle="{StaticResource BrandFocus}" AutomationProperties.Name="Журнал работы">
                            <TextBox.Template><ControlTemplate TargetType="TextBox">
                                <Border Background="{DynamicResource BrandPanel}" BorderBrush="{DynamicResource BrandLine}" BorderThickness="1" CornerRadius="12" Padding="12,8,4,8">
                                    <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource PageScrollViewer}" Focusable="False"/>
                                </Border>
                            </ControlTemplate></TextBox.Template>
                        </TextBox>
                    </Grid>
                    <Border x:Name="EmptyJournalHint" Grid.Row="1" VerticalAlignment="Top" Padding="16" Background="{DynamicResource BrandHero}" BorderBrush="{DynamicResource BrandHeroLine}" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=JournalBody}" Value="Collapsed"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Width="19" Height="23" Stretch="Uniform" VerticalAlignment="Top" Margin="0,3,12,0" Stroke="{DynamicResource BrandAccent}" StrokeThickness="1.5"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 3,2 h 14 v 16 h -14 Z M 6.5,7 h 7 M 6.5,11 h 7"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Записей пока нет" FontWeight="SemiBold" FontSize="21" TextWrapping="Wrap"/>
                                <TextBlock Text="Здесь появятся результаты проверок, обновления и сообщения zapret." Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
