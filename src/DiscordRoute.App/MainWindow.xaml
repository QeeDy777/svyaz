<Window x:Class="DiscordRoute.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DiscordRoute.App"
    Title="Связь" Width="440" Height="680" ResizeMode="CanMinimize" Icon="Assets/app.ico"
    WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable, Segoe UI"
    FontSize="14" UseLayoutRounding="True" Language="ru-RU"
    Background="{DynamicResource BrandPaper}"
    Foreground="{DynamicResource BrandInk}">
    <Window.Resources>
        <local:EmptyVisibilityConverter x:Key="EmptyVisibility"/>
        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="Background" Value="{DynamicResource BrandGreen}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandWhite}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandGreen}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Margin="-9" Fill="{DynamicResource BrandMint}"/>
                            <Ellipse x:Name="Surface" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"/>
                            <Path Width="42" Height="46" Stretch="Uniform" Data="M 20,0 L 20,23 M 8,8 A 20,20 0 1 0 32,8"
                                Stroke="{TemplateBinding Foreground}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse x:Name="FocusRing" Margin="-6" Stroke="{DynamicResource BrandGreen}" StrokeThickness="2" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Fill" Value="{DynamicResource BrandHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Fill" Value="{DynamicResource BrandInk}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type local:ServiceCheck}">
            <Grid ToolTip="{Binding Detail}" Margin="0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="13"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrandMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Passed"><Setter Property="Foreground" Value="{DynamicResource BrandGreen}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource BrandError}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <Style x:Key="FlatSection" TargetType="Border">
            <Setter Property="Padding" Value="0,0,0,24"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandLine}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28,24,28,18" MaxWidth="660">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Связь" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{Binding AppUpdates.Version}" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
            <TabItem Header="Discord" Padding="10,12" AutomationProperties.Name="Подключение Discord">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,20,8,8">
                    <StackPanel>
                        <TextBlock Text="{Binding Heading}" FontSize="25" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" TextAlignment="Center" LineHeight="21" MinHeight="44"/>
                        <Grid Margin="0,22,0,22" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PowerButton}" Command="{Binding PrimaryCommand}" AutomationProperties.Name="{Binding PrimaryActionLabel}" ToolTip="{Binding PrimaryActionLabel}"/>
                        </Grid>
                        <TextBlock Text="{Binding PrimaryActionLabel}" TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid Height="3" Margin="60,0,60,8">
                            <ProgressBar Value="100" IsIndeterminate="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                                Visibility="{Binding IsBusy, Converter={StaticResource VisibleIfTrue}}" AutomationProperties.Name="Выполняется операция"/>
                        </Grid>
                        <StackPanel Margin="0,0,0,14">
                            <ContentControl Content="{Binding Api}"/>
                            <ContentControl Content="{Binding Gateway}"/>
                            <ContentControl Content="{Binding Voice}"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource BrandLine}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                            <Expander Header="История проверок" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="После подключения здесь появятся результаты подбора." Style="{StaticResource SecondaryText}" Margin="0,0,0,12"
                                        Visibility="{Binding Results.Count, Converter={StaticResource EmptyVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding Results}" AutomationProperties.Name="Результаты проверки стратегий">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BrandLine}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                        <TextBlock Text="{Binding Api, StringFormat=API: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Gateway, StringFormat=Gateway: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Voice, StringFormat=Голос: {0}}" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Telegram" Padding="10,12" AutomationProperties.Name="Telegram">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,20,8,8">
                    <StackPanel DataContext="{Binding Telegram}">
                        <TextBlock Text="Telegram" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Локальный прокси Flowseal" Style="{StaticResource SecondaryText}" Margin="0,0,0,20"/>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/>
                        <Button Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" Padding="18,12" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                        <Button Style="{StaticResource QuietButton}" Content="Открыть в Telegram" Command="{Binding OpenCommand}" Padding="18,10" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource QuietButton}" Content="Скопировать ссылку" Command="{Binding CopyCommand}" Padding="18,10" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding Endpoint}" Style="{StaticResource SecondaryText}"/>
                        <TextBlock Text="{Binding Version}" Style="{StaticResource SecondaryText}" Margin="0,4,0,20"/>
                        <Expander Header="Настройки Telegram" HorizontalContentAlignment="Stretch" Margin="0,0,0,20">
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel IsEnabled="{Binding CanEdit}">
                                    <Label Content="Локальный порт" Target="{Binding ElementName=TelegramPort}" Padding="0" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TelegramPort" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" MinHeight="38" AutomationProperties.Name="Локальный порт Telegram"/>
                                    <CheckBox Content="Запускать вместе со «Связью»" IsChecked="{Binding StartWithApp}" Margin="0,16,0,16"/>
                                    <Button Style="{StaticResource QuietButton}" Content="Сохранить настройки" Command="{Binding SaveCommand}" Padding="18,10" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <Button Style="{StaticResource QuietButton}" Content="Загрузить / обновить компонент" Command="{Binding UpdateCommand}" Padding="18,10" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <TextBlock Text="Перед изменением настроек остановите прокси. Автообновление использует общий флажок в настройках и не прерывает работающий Telegram-прокси." Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Подтвердите прокси в Telegram. После остановки выключите его в Telegram или снова запустите здесь. Готовность локального порта не подтверждает работу сообщений и звонков." Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/>
                        <TextBlock Text="У TG WS Proxy остаётся собственный значок в трее для расширенных настроек. Discord подключается независимо." Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Настройки" Padding="10,12" AutomationProperties.Name="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,20,8,8">
                    <StackPanel>
                        <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,22"/>
                        <Border Style="{StaticResource FlatSection}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Работает автоматически" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Подключать при входе в Windows" IsChecked="{Binding AutostartEnabled, Mode=OneWay}" Command="{Binding AutostartCommand}" Margin="0,0,0,8"/>
                                <TextBlock Text="Подключение начнётся через 15 секунд после входа. Приложение останется в трее." Style="{StaticResource SecondaryText}" Margin="28,0,0,22"/>
                                <CheckBox Content="Обновлять «Связь» и компоненты" IsChecked="{Binding AutoUpdateEnabled}" Command="{Binding AutoUpdateCommand}" Margin="0,0,0,8"/>
                                <TextBlock Text="Проверка каждые 6 часов. «Связь» скачивается в фоне и обновляется при следующем запуске. Telegram — только при остановленном прокси." Style="{StaticResource SecondaryText}" Margin="28,0,0,16"/>
                                <Button Style="{StaticResource QuietButton}" Content="Обновить альты" Command="{Binding UpdateCommand}" HorizontalAlignment="Left" Padding="18,10"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatSection}" Margin="0,0,0,16" DataContext="{Binding AppUpdates}">
                            <StackPanel>
                                <TextBlock Text="Обновление «Связи»" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource QuietButton}" Content="Проверить новую версию" Command="{Binding CheckCommand}" HorizontalAlignment="Left" Padding="18,10" Margin="0,0,0,8"/>
                                <Button Content="Обновить и перезапустить" Command="{Binding RestartCommand}" HorizontalAlignment="Left" Padding="18,10"/>
                                <TextBlock Text="Перезапуск кратко прервёт подключения. Предыдущая версия и настройки сохраняются." Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatSection}" Margin="0,0,0,16">
                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <TextBlock Text="Игры · Game Filter" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Режим" Target="{Binding ElementName=GameFilterPicker}" Padding="0" Margin="0,0,0,8"/>
                                <ComboBox x:Name="GameFilterPicker" ItemsSource="{Binding GameFilterModes}" SelectedIndex="{Binding GameFilterModeIndex}" MinHeight="38" AutomationProperties.Name="Режим Game Filter"/>
                                <TextBlock Text="{Binding GameFilterSummary}" Style="{StaticResource SecondaryText}" Margin="0,8,0,12"/>
                                <Expander Header="Диапазоны портов" HorizontalContentAlignment="Stretch" Margin="0,0,0,16">
                                    <StackPanel Margin="0,12,0,0">
                                        <Label Content="TCP" Target="{Binding ElementName=GameTcpInput}" Padding="0" Margin="0,0,0,6"/>
                                        <TextBox x:Name="GameTcpInput" Text="{Binding GameFilterTcpPorts, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" MinHeight="38" AutomationProperties.Name="TCP порты Game Filter"/>
                                        <Label Content="UDP" Target="{Binding ElementName=GameUdpInput}" Padding="0" Margin="0,12,0,6"/>
                                        <TextBox x:Name="GameUdpInput" Text="{Binding GameFilterUdpPorts, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" MinHeight="38" AutomationProperties.Name="UDP порты Game Filter"/>
                                        <TextBlock Text="По умолчанию: 1024–65535. Можно указать несколько портов и диапазонов через запятую." Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Expander>
                                <Button Style="{StaticResource QuietButton}" Content="Сохранить Game Filter" Command="{Binding GameFilterCommand}" HorizontalAlignment="Left" Padding="18,10"/>
                                <TextBlock Text="{Binding GameFilterFeedback}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="{Binding GameFilterHint}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                                <TextBlock Text="Обрабатывает выбранные порты для сетей из IPSet Flowseal. Работу конкретной игры нужно проверить в игре." Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlatSection}">
                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <TextBlock Text="Параметры подключения" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Стратегия" Target="{Binding ElementName=StrategyPicker}" Padding="0" Margin="0,0,0,8"/>
                                <ComboBox x:Name="StrategyPicker" ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" MinHeight="38" AutomationProperties.Name="Стратегия обхода"/>
                                <TextBlock Text="При автоподборе последняя рабочая стратегия проверяется первой." Style="{StaticResource SecondaryText}" Margin="0,8,0,22"/>
                                <Label Content="Голосовой сервер · необязательно" Target="{Binding ElementName=VoiceInput}" Padding="0" Margin="0,0,0,8"/>
                                <TextBox x:Name="VoiceInput" Text="{Binding VoiceAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" AutomationProperties.Name="Адрес голосового сервера"/>
                                <TextBlock Text="Оставьте пустым для определения из журнала Discord. Если адрес ещё не появился, откройте голосовой канал. Формат: имя.discord.media:порт." Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Журнал" Padding="10,12" AutomationProperties.Name="Журнал">
                <Grid Margin="8,20,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Журнал работы" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Text="Результаты проверок, обновления и сообщения zapret. Текст можно выделить и скопировать." Style="{StaticResource SecondaryText}" Margin="0,0,0,20"/>
                    <TextBox Grid.Row="2" Text="{Binding Journal, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                        TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="16" AutomationProperties.Name="Журнал работы"/>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding PackageVersion}" Style="{StaticResource SecondaryText}" FontSize="12" HorizontalAlignment="Center" Margin="0,20,0,0"/>
    </Grid>
</Window>
