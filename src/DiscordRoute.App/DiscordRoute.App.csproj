<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <StartupObject>DiscordRoute.App.Program</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Связь</AssemblyName>
    <Product>Связь</Product>
    <Title>Связь</Title>
    <Description>Подключение Discord и локальный прокси Telegram</Description>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" />
    <Using Include="System.IO" /><Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../DiscordRoute.Core/DiscordRoute.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/app.ico" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../dist/telegram-runtime.zip" LogicalName="TelegramRuntime.zip" /></ItemGroup>
  <ItemGroup><Content Include="../../licenses/*.txt" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="DiscordRoute.WindowsChecks" /></ItemGroup>
</Project>
